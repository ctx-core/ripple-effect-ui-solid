{
	"name": "@ctx-core/ripple-effect-ui-solid",
	"version": "1.3.238",
	"description": "ctx-core ripple-effect Solidjs component",
	"keywords": [
		"ctx-core",
		"ripple-effect"
	],
	"homepage": "https://github.com/ctx-core/ripple-effect-ui-solid#readme",
	"bugs": {
		"url": "https://github.com/ctx-core/ripple-effect-ui-solid/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ctx-core/ripple-effect-ui-solid.git"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "Brian Takita",
		"url": "https://briantakita.me",
		"email": "info+ctx-core-ripple-effect-ui-solid@briantakita.me"
	},
	"type": "module",
	"module": "./index.jsx",
	"files": [
		"*.d.ts",
		"*.js",
		"*.json",
		"./RippleEffect"
	],
	"types": "./index.d.ts",
	"scripts": {
		"build": ":",
		"clean": ":",
		"exec": "$@",
		"prepublishOnly": "bun run clean && bun run build && bun run test && publint && attw --pack --ignore-rules cjs-resolves-to-esm",
		"test": "bun run test:types && bun run test:unit",
		"test:types": "tsc --noEmit",
		"test:unit": "tsx node_modules/uvu/bin.js . '\\.test\\.(ts|js)$'",
		"disable:test:unit:coverage": "c8 bun run test:unit"
	},
	"dependencies": {
		"@ctx-core/ripple-effect": "*",
		"@ctx-core/ui-solid": "*",
		"ctx-core": "*",
		"solid-js": "^1.9.14"
	},
	"devDependencies": {
		"c8": "^12.0.0",
		"tsx": "^4.23.1",
		"typescript": "next",
		"uvu": "^0.5.6"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false
}